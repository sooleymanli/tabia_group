{
  "name": "tabia_group",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:certs": "mkdir -p .certs && security find-certificate -a -p /Library/Keychains/System.keychain /System/Library/Keychains/SystemRootCertificates.keychain ~/Library/Keychains/login.keychain-db > .certs/system-ca.pem",
    "db:login": "npm run db:certs && NODE_EXTRA_CA_CERTS=\"$PWD/.certs/system-ca.pem\" SSL_CERT_FILE=\"$PWD/.certs/system-ca.pem\" supabase login",
    "db:link": "npm run db:certs && NODE_EXTRA_CA_CERTS=\"$PWD/.certs/system-ca.pem\" SSL_CERT_FILE=\"$PWD/.certs/system-ca.pem\" supabase link",
    "db:push": "npm run db:certs && NODE_EXTRA_CA_CERTS=\"$PWD/.certs/system-ca.pem\" SSL_CERT_FILE=\"$PWD/.certs/system-ca.pem\" supabase db push",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
